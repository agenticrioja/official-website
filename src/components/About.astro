---
import aaif from '../assets/brand/aaif-logo-black.svg';
import cloudNativeRioja from '../assets/community/cloud-native-rioja.svg';
import { AAIF_URL, CLOUD_NATIVE_RIOJA_URL, CNCF_URL, LF_COC_URL } from '../site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
interface Props { locale: Locale }
const t = ui[Astro.props.locale];
---
<section id="about" class="bg-sand/60">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-[1.2fr_1fr] md:py-24">
    <div>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">{t.about.heading}</h2>
      <p class="mt-5 text-lg text-ink/80">
        {t.about.p1}
      </p>
      <p class="mt-4 text-lg text-ink/80">
        {t.about.p2}
      </p>
      <div class="community-split">
        <a href={CLOUD_NATIVE_RIOJA_URL} aria-label="Cloud Native Rioja" class="community-split__logo">
          <img src={cloudNativeRioja.src} alt="" width="196" height="40" loading="lazy" />
        </a>
        <p class="community-split__copy">
          <span class="community-split__title">{t.about.sibling}</span> {t.about.siblingText} <a href={CNCF_URL}>Cloud Native Computing Foundation</a>, {t.about.siblingEnd}{" "}
          <a href={CLOUD_NATIVE_RIOJA_URL}>cloudnativerioja.com</a>
        </p>
      </div>
    </div>
    <div class="self-start rounded-3xl bg-white p-8 ring-1 ring-ink/5">
      <a href={AAIF_URL} aria-label="Agentic AI Foundation (AAIF)"><img src={aaif.src} alt="" width="165" height="40" class="mb-6 h-10 w-auto" loading="lazy" /></a>
      <p class="text-xs font-semibold tracking-wide text-vine uppercase">{t.about.bigger}</p>
      <h3 class="mt-2 text-xl font-semibold">{t.about.chapter}</h3>
      <p class="mt-3 text-ink/80">
        {t.about.chapterText}
      </p>
      <p class="mt-5 text-sm">
        <a href={AAIF_URL} class="font-semibold text-wine underline">{t.about.aaif}</a>{" "}·{" "}
        <a href={LF_COC_URL} class="font-semibold text-wine underline">{t.about.coc}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .community-split {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.75rem;
    border: 1px solid rgb(31 26 23 / 5%);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 72%);
  }

  .community-split__logo {
    display: flex;
    align-items: center;
  }

  .community-split__logo img {
    width: 196px;
    max-width: 100%;
    height: auto;
  }

  .community-split__copy {
    margin: 0;
    color: rgb(31 26 23 / 82%);
    font-size: 1rem;
    line-height: 1.6;
  }

  .community-split__title {
    display: block;
    margin-bottom: .375rem;
    color: var(--color-ink);
    font-weight: 700;
  }

  .community-split__copy a {
    text-underline-offset: 3px;
  }

  .community-split__copy a:last-child {
    color: var(--color-wine);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (min-width: 68.75rem) {
    .community-split {
      grid-template-columns: 196px minmax(0, 1fr);
      align-items: center;
    }

    .community-split__logo {
      padding-right: 1.5rem;
      border-right: 1px solid rgb(31 26 23 / 12%);
    }
  }
</style>
