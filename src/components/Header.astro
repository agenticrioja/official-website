---
import LogoMark from './LogoMark.astro';
import { LUMA_URL, NAV } from '../site';
---
<header class="sticky top-0 z-50 border-b border-ink/10 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2.5" aria-label="Agentic Rioja: home">
      <LogoMark class="h-9 w-9" />
      <span class="leading-tight">
        <span class="block font-display text-lg font-bold">Agentic Rioja</span>
        <span class="block text-[11px] font-medium text-ink/70">Logroño · La Rioja</span>
      </span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-6 text-sm font-medium md:flex">
      {NAV.map(([label, href]) => <a href={href} class="hover:text-wine">{label}</a>)}
      <a href={LUMA_URL} class="rounded-full bg-wine px-4 py-2 text-white hover:bg-wine-deep">Join us on Luma</a>
    </nav>
    <details id="mobile-menu" class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-ink/20 px-4 py-2 text-sm font-medium">Menu</summary>
      <nav aria-label="Mobile" class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-2xl border border-ink/10 bg-white p-3 text-sm font-medium shadow-lg">
        {NAV.map(([label, href]) => <a href={href} class="rounded-lg px-3 py-2 hover:bg-cream">{label}</a>)}
        <a href={LUMA_URL} class="mt-1 rounded-full bg-wine px-4 py-2 text-center text-white">Join us on Luma</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after picking a link or clicking outside it.
  const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
</script>
