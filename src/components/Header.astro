---
import LogoMark from './LogoMark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { LUMA_URL } from '../site';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../i18n/locales';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---
<header class="sticky top-0 z-50 border-b border-ink/10 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={localePath(locale)} class="flex items-center gap-2.5" aria-label={t.home}>
      <LogoMark class="h-9 w-9" />
      <span class="leading-tight">
        <span class="block font-display text-lg font-bold">Agentic Rioja</span>
        <span class="block text-[11px] font-medium text-ink/70">Logroño · La Rioja</span>
      </span>
    </a>
    <nav aria-label={t.mainNav} class="hidden items-center gap-5 text-sm font-medium md:flex">
      {t.nav.map(([label, href]) => <a href={href} class="header-link hover:text-wine">{label}</a>)}
      <LanguageSwitcher locale={locale} />
      <a href={LUMA_URL} class="header-join rounded-full bg-wine px-4 py-2 text-white hover:bg-wine-deep">{t.joinLuma}</a>
    </nav>
    <details id="mobile-menu" class="relative md:hidden">
      <summary class="menu-trigger flex min-h-11 cursor-pointer list-none items-center rounded-full border border-ink/20 px-4 py-2 text-sm font-medium">{t.menu}</summary>
      <nav aria-label={t.mobileNav} class="mobile-nav absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-2xl border border-ink/10 bg-white p-3 text-sm font-medium shadow-lg">
        {t.nav.map(([label, href]) => <a href={href} class="rounded-lg px-3 py-2 hover:bg-cream">{label}</a>)}
        <LanguageSwitcher locale={locale} compact />
        <a href={LUMA_URL} class="mt-1 rounded-full bg-wine px-4 py-2 text-center text-white">{t.joinLuma}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after picking a link or clicking outside it.
  const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
</script>

<style>
  .header-link {
    position: relative;
    transition: color 160ms ease-out;
  }

  .header-link::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--color-wine);
    content: '';
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 180ms cubic-bezier(.16, 1, .3, 1);
  }

  .header-link:hover::after,
  .header-link:focus-visible::after {
    transform: scaleX(1);
  }

  .header-join,
  .menu-trigger,
  .mobile-nav a {
    transition: background-color 160ms ease-out;
  }

  .menu-trigger {
    gap: .65rem;
  }

  .menu-trigger::after {
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: '';
    transform: translateY(-2px) rotate(45deg);
    transition: transform 180ms cubic-bezier(.16, 1, .3, 1);
  }

  details[open] > .menu-trigger::after {
    transform: translateY(2px) rotate(225deg);
  }

  details[open] > .mobile-nav {
    animation: menu-arrive 220ms cubic-bezier(.16, 1, .3, 1) both;
    transform-origin: top right;
  }

  @keyframes menu-arrive {
    from { opacity: .75; transform: translateY(-6px) scale(.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-link::after,
    .menu-trigger::after { transition-duration: 0ms; }
    details[open] > .mobile-nav { animation: none; }
  }
</style>
