---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate } from '../lib/events';
interface Props { event: CollectionEntry<'events'>; past?: boolean }
const { event, past = false } = Astro.props;
const { title, date, tba, venue, lumaUrl, summary, speakers } = event.data;
---
<article class="flex flex-col rounded-3xl bg-white p-6 text-ink">
  <p class="text-sm font-semibold text-wine">
    {formatEventDate({ date, tba })}
  </p>
  <h3 class="mt-2 text-xl font-semibold">{title}</h3>
  {venue && <p class="mt-1 text-sm text-ink/70">{venue}</p>}
  <p class="mt-3 text-ink/80">{summary}</p>
  {speakers.length > 0 && <p class="mt-3 text-sm"><span class="font-semibold">Speakers:</span> {speakers.join(', ')}</p>}
  {lumaUrl && (
    <a href={lumaUrl} class="mt-5 self-start rounded-full bg-wine px-5 py-2 text-sm font-semibold text-white hover:bg-ink">
      {past ? 'View on Luma' : tba ? 'Get notified on Luma' : 'RSVP on Luma'}
    </a>
  )}
</article>
