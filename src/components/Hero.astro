---
import LogronoScene from './LogronoScene.astro';
import { LUMA_URL } from '../site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---
<section class="overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-[1.1fr_1fr] md:py-20">
    <div>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-wine/10 px-3 py-1 text-xs font-semibold tracking-wide text-wine">
        <span class="h-2 w-2 rounded-full bg-wine"></span> Logroño · La Rioja
      </p>
      <h1 class="font-display text-4xl leading-[1.05] font-bold sm:text-5xl lg:text-6xl">
        {t.hero.title} <span class="text-wine italic">{t.hero.accent}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink/80">
        {t.hero.body}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={LUMA_URL} class="hero-action rounded-full bg-wine px-6 py-3 font-semibold text-white hover:bg-wine-deep">{t.joinLuma}</a>
        <a href="#events" class="hero-action rounded-full border border-ink/25 px-6 py-3 font-semibold hover:bg-white">{t.hero.events}</a>
      </div>
      <p class="mt-6 font-display text-lg text-ink/70 italic">{t.hero.signoff}</p>
    </div>
    <LogronoScene class="w-full rounded-[2rem] shadow-xl shadow-wine/10" label={t.hero.scene} />
  </div>
</section>

<style>
  .hero-action {
    transition: background-color 160ms ease-out, transform 160ms cubic-bezier(.16, 1, .3, 1);
  }

  .hero-action:active {
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-action { transition: background-color 120ms ease-out; }
    .hero-action:active { transform: none; }
  }
</style>
