---
import { LUMA_URL } from '../site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
interface Props { locale: Locale }
const t = ui[Astro.props.locale];
---
<section id="join" class="bg-vine text-white">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] md:items-start md:gap-20 md:py-24">
    <div>
      <h2 class="max-w-lg text-balance font-display text-3xl font-bold sm:text-4xl">{t.join.heading}</h2>
      <p class="mt-4 max-w-xl text-lg text-white/90">{t.join.intro}</p>
      <a href={LUMA_URL} class="mt-8 inline-flex min-h-11 items-center rounded-full bg-cream px-6 py-3 font-semibold text-ink transition-colors hover:bg-white">{t.joinLuma}</a>
    </div>
    <ul class="divide-y divide-white/20 border-y border-white/20">
      {t.join.items.map((item) => (
        <li class="py-5 first:pt-0 last:pb-0 md:first:pt-5 md:last:pb-5">
          <h3 class="text-xl font-semibold">{item[0]}</h3>
          <p class="mt-1.5 max-w-xl text-white/85">{item[1]}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
