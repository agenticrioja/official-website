---
import { LUMA_URL } from '../site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
interface Props { locale: Locale }
const t = ui[Astro.props.locale];
---
<section id="join" class="bg-vine text-white">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <h2 class="font-display text-3xl font-bold sm:text-4xl">{t.join.heading}</h2>
    <p class="mt-4 max-w-2xl text-lg text-white">{t.join.intro}</p>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {t.join.items.map((item) => (
        <article class="rounded-3xl bg-black/15 p-6 ring-1 ring-white/15">
          <h3 class="text-xl font-semibold">{item[0]}</h3>
          <p class="mt-2 text-white">{item[1]}</p>
        </article>
      ))}
    </div>
    <a href={LUMA_URL} class="mt-8 inline-block rounded-full bg-cream px-6 py-3 font-semibold text-ink hover:bg-white">{t.joinLuma}</a>
  </div>
</section>
