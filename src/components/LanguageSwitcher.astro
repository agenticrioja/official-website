---
import { localePath, type Locale } from '../i18n/locales';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
---
<div role="group" aria-label={locale === 'es' ? 'Idioma' : 'Language'} class:list={['language-switcher flex items-center rounded-full border border-ink/20 p-0.5 text-xs font-semibold', compact && 'self-start']}>
  <a href={localePath('es')} data-locale="es" lang="es" aria-current={locale === 'es' ? 'page' : undefined} class="flex min-h-12 min-w-12 items-center justify-center rounded-full px-2.5 py-1 underline-offset-2 aria-[current=page]:bg-wine aria-[current=page]:text-white aria-[current=page]:underline">ES</a>
  <a href={localePath('en')} data-locale="en" lang="en" aria-current={locale === 'en' ? 'page' : undefined} class="flex min-h-12 min-w-12 items-center justify-center rounded-full px-2.5 py-1 underline-offset-2 aria-[current=page]:bg-wine aria-[current=page]:text-white aria-[current=page]:underline">EN</a>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.language-switcher a[data-locale]').forEach((link) => {
    if (link.dataset.localeReady) return;
    link.dataset.localeReady = 'true';
    link.addEventListener('click', () => {
      const locale = link.dataset.locale;
      if (location.hash) link.href = `${link.href.split('#')[0]}${location.hash}`;
      try {
        if (locale) localStorage.setItem('agentic-rioja-locale', locale);
      } catch {
        // Language switching still works when storage is unavailable.
      }
    });
  });
</script>
