---
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
interface Props { locale: Locale }
const t = ui[Astro.props.locale];
---
<section id="how" class="mx-auto max-w-6xl px-4 py-16 md:py-24">
  <h2 class="font-display text-3xl font-bold sm:text-4xl">{t.meetup.heading}</h2>
  <ol class="mt-10 grid gap-5 md:grid-cols-3">
    {t.meetup.steps.map((s, i) => (
      <li class="rounded-3xl border-2 border-dashed border-wine/25 p-6">
        <span class="font-display text-4xl font-bold text-wine">{i + 1}</span>
        <h3 class="mt-2 text-xl font-semibold">{s[0]}</h3>
        <p class="mt-2 text-ink/80">{s[1]}</p>
      </li>
    ))}
  </ol>
</section>
