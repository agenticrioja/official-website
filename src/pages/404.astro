---
import Base from '../layouts/Base.astro';
import LogoMark from '../components/LogoMark.astro';
---
<Base title="Page not found · Agentic Rioja">
  <main id="main" class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center gap-4 px-4 text-center">
    <LogoMark class="h-16 w-16" />
    <h1 class="font-display text-5xl font-bold">404</h1>
    <p class="text-lg text-ink/80">This agent took a wrong turn somewhere around the Espolón.</p>
    <a href="/" class="rounded-full bg-wine px-6 py-3 font-semibold text-white hover:bg-wine-deep">Back home</a>
  </main>
</Base>
