---
import '../styles/global.css';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale; title?: string; description?: string; detectBrowserLanguage?: boolean }
const {
  locale,
  title = ui[locale].meta.title,
  description = ui[locale].meta.description,
  detectBrowserLanguage = false,
} = Astro.props;
const canonical = new URL(locale === 'es' ? '/' : '/en/', Astro.site);
const spanish = new URL('/', Astro.site);
const english = new URL('/en/', Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Agentic Rioja',
  alternateName: 'AAIF Logroño Chapter',
  url: 'https://agenticrioja.com',
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description,
  memberOf: { '@type': 'Organization', name: 'Agentic AI Foundation', url: 'https://aaif.io' },
  address: { '@type': 'PostalAddress', addressLocality: 'Logroño', addressRegion: 'La Rioja', addressCountry: 'ES' },
  sameAs: ['https://luma.com/aaif-logrono'],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {detectBrowserLanguage && <script is:inline set:html={`try{const s=localStorage.getItem('agentic-rioja-locale');const l=(navigator.languages&&navigator.languages[0])||navigator.language||'';if(s==='en'||(s!=='es'&&!l.toLowerCase().startsWith('es'))){location.replace('/en/'+location.search+location.hash)}}catch(e){}`} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanish} />
    <link rel="alternate" hreflang="en" href={english} />
    <link rel="alternate" hreflang="x-default" href={spanish} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3d0f22" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agentic Rioja" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_GB' : 'es_ES'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui[locale].meta.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-cream font-sans text-ink antialiased">
    <a href="#main" class="sr-only z-[100] rounded-full bg-ink px-4 py-2 text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3">{ui[locale].skip}</a>
    <slot />
  </body>
</html>
