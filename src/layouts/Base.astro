---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const {
  title = 'Agentic Rioja · The AI agents community in Logroño, La Rioja',
  description = 'Agentic Rioja is the AI agents community in Logroño and La Rioja: meetups with talks, live demos and good conversation. Logroño chapter of the Agentic AI Foundation.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Agentic Rioja',
  alternateName: 'AAIF Logroño Chapter',
  url: 'https://agenticrioja.com',
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  description,
  memberOf: { '@type': 'Organization', name: 'Agentic AI Foundation', url: 'https://aaif.io' },
  address: { '@type': 'PostalAddress', addressLocality: 'Logroño', addressRegion: 'La Rioja', addressCountry: 'ES' },
  sameAs: ['https://luma.com/aaif-logrono'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3d0f22" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agentic Rioja" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agentic Rioja: an illustrated Logroño skyline with a small robot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-cream font-sans text-ink antialiased">
    <a href="#main" class="sr-only z-[100] rounded-full bg-ink px-4 py-2 text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <slot />
  </body>
</html>
